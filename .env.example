# Neon Postgres connection string.
# Get this from your Neon project dashboard (neon.tech) after creating a project.
# Use the pooled connection string for the app.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct (non-pooler) URL — preferred for drizzle-kit migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Which project this deployment governs (§10). Leave blank locally if you're
# working across multiple projects; set per-environment in Vercel otherwise.
CORIN_DEFAULT_PROJECT_SLUG="carromlive"

# Auth.js (§11) — required in production
AUTH_SECRET="generate-a-long-random-string"

# Optional GitHub OAuth
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Compiler LLM target resolution (§4) — must differ from the build agent model
# CORIN_COMPILER_LLM_API_KEY=
# CORIN_COMPILER_LLM_BASE_URL=https://api.openai.com/v1
# CORIN_COMPILER_LLM_MODEL=gpt-4o-mini

# MCP role: ideation | coding
# CORIN_MCP_ROLE=coding
