# Neon Postgres — Vercel Neon integration prefixes these with BLUMEDB_.
# Locally you can use either the BLUMEDB_ names or the unprefixed aliases.

# Pooled connection string (app runtime)
BLUMEDB_DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL=  # optional local alias

# Direct (non-pooler) URL — preferred for drizzle-kit migrations
BLUMEDB_DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL_UNPOOLED=  # optional local alias

# Which project this deployment governs (§10). Leave blank locally if you're
# working across multiple projects; set per-environment in Vercel otherwise.
BLUME_DEFAULT_PROJECT_SLUG="carromlive"

# Auth.js (§11) — required in production
AUTH_SECRET="generate-a-long-random-string"

# Optional GitHub OAuth
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Compiler LLM target resolution (§4) — must differ from the build agent model
# BLUME_COMPILER_LLM_API_KEY=
# BLUME_COMPILER_LLM_BASE_URL=https://api.openai.com/v1
# BLUME_COMPILER_LLM_MODEL=gpt-4o-mini

# MCP role: ideation | coding
# BLUME_MCP_ROLE=coding

# Clerk (§11) — https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Portal auth paths (app.getblume.ai)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
